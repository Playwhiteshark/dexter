# ============================================================
# Python environments / generated Python files
# ============================================================
**/.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================================================
# Machine-local configuration / secrets
# ============================================================
.env
.env.*
!.env.example
**/local_config.py

# ============================================================
# Dexter tool generated test / benchmark output
# ============================================================
**/_dexter_tool_tests/
**/benchmark_runs/

# ============================================================
# Existing Goose generated runs
# Keep harness source code/configs; ignore run artifacts.
# ============================================================
Harnesses/Goose/assistant-bench-runs/
Harnesses/Goose/diagnostic-runs/

# ============================================================
# Model Gateway runtime traces
# Keep gateway/config/source code.
# ============================================================
Runtime/Model Gateway/ollama_advisor_debug.jsonl
Runtime/Model Gateway/ollama_advisor_trace.jsonl
Runtime/Model Gateway/ollama_proxy_trace.jsonl

# Historical/manual backups; Git will provide history going forward.
Runtime/Model Gateway/Archive/

# Machine-specific exported Scheduled Task snapshots.
Runtime/Model Gateway/Scheduled Task/

# ============================================================
# Generated diagnostic reports
# Keep the scripts that generate them.
# ============================================================
Diagnostics/jarvis-config-audit_*.md
Diagnostics/runtime-performance-audit_*.json

# ============================================================
# Local duplicate/package copies of Dexter Tools
# Track Runtime/Tools/dexter-tools/ itself.
# ============================================================
Runtime/Tools/dexter-tools.zip
Runtime/Tools/dexter-tools-v0.1/

# Dexter voice prototype
Runtime/Voice/stt_prototype.py
Runtime/Voice/.venv/
Runtime/Voice/debug/
Runtime/Voice/ptt_debug/
Runtime/Voice/*.wav
Runtime/Voice/__pycache__/

# ============================================================
# Large model weights if added later
# Keep Modelfiles and model configuration.
# ============================================================
*.gguf
*.safetensors
*.ckpt
*.pth
*.pt

# ============================================================
# Editors / operating system
# ============================================================
.vscode/
.idea/
.DS_Store
Thumbs.db
Runtime/Host/.venv/
Runtime/Host/__pycache__/

# Dexter local/generated development artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# One-off local diagnostic outputs
/goose_ollama_capture/
/personality_probe_results_*.json
/prompt_endpoint_matrix_*.json
/tools_style_probe_catalog_*.json
/tools_style_probe_results_*.json

# Patch-delivery archives belong outside the source tree
/dexter_workspace_*.zip
/dexter_operational_memory_workspace_update_*.zip
