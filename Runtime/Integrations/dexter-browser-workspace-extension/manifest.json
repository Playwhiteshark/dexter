{
  "manifest_version": 3,
  "name": "Dexter Workspace Bridge",
  "version": "0.1.1",
  "description": "Local-only browser workspace state bridge for Dexter.",
  "minimum_chrome_version": "105",
  "key": "",
  "permissions": [
    "tabs",
    "tabGroups",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "service_worker.js"
  }
}
